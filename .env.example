# ---- Agents worker (/agents reads ../.env or agents/.env) ----
# Never put these keys in /web. The browser bundle must stay secret-free.
LLM_PROVIDER=gemini                # gemini | nvidia — starting model; the dashboard's AI model picker overrides it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite # confirmed "Stable" on the Gemini models page, 2026-11-07
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Set to 1 to force stored fallbacks even when keys exist (demo safety switch)
LLM_FORCE_FALLBACK=0
# Minimum milliseconds between model calls (free-tier friendly)
LLM_MIN_INTERVAL_MS=4000

# NWS requires a User-Agent that identifies your app + a contact
NWS_USER_AGENT=(welfare-check-hackutd-concept, you@example.com)
WEATHER_INTERVAL_MIN=10

# SpacetimeDB connection for Node clients (agents + seed)
STDB_URI=ws://localhost:3000
STDB_DB=welfare-check

# ---- Web (/web/.env.local). Only VITE_* values reach the browser. No secrets here. ----
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_DB=welfare-check
