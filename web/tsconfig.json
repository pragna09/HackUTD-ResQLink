{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@bindings": ["./src/module_bindings"]
    }
  },
  "include": ["src", "../module/src/logic.ts", "../module/src/seed_data.ts"],
  "exclude": ["src/stdb/bindings-stub.ts"]
}
