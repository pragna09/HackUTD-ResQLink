{
  "expo": {
    "name": "ResQLink",
    "slug": "resqlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resqlink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.resqlink.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.resqlink.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-nearby-connections",
        {
          "bonjourServicesName": "resqlink",
          "localNetworkUsagePermissionText": "$(PRODUCT_NAME) finds nearby phones to relay SOS messages when there is no signal.",
          "bluetoothUsagePermissionText": "$(PRODUCT_NAME) uses Bluetooth to pass SOS messages phone-to-phone when there is no signal."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "$(PRODUCT_NAME) shares your location with responders only when you join the mesh or send an SOS."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
